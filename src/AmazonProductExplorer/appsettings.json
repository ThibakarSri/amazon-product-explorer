{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Oxylabs": {
    "MaxSearchPages": 6,
    "MaxConcurrentDetails": 3,
    "PollIntervalSeconds": 3,
    "JobTimeoutSeconds": 180
  }
}
